# TeamSync AI - Environment Configuration Example
# Copy to .env for local overrides

# Database URL for PostgreSQL connection
# Example: postgresql://username:password@localhost:5432/teamsync_ai?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamsync_ai?schema=public"

# Session JWT Secret Key (min 32 characters in production)
JWT_SECRET="teamsync-ai-secure-college-session-secret-key-2026-production-ready"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3000
